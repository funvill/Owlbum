# Text files are stored and checked out with LF on every platform, so that
# generated bindings, rustfmt and the shell scripts agree on Windows and Linux.
* text=auto eol=lf

*.png binary
*.ico binary
*.icns binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.jxl binary
*.bin binary

# Windows-only scripts keep CRLF.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
